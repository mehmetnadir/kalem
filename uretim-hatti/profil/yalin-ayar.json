{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sef/.local/bin/kanca-bash",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sef/01dev/conductor/hooks/tarayici-kapisi.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash /home/sef/.claude/hooks/playwright-to-cdpilot.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sef/.claude/hooks/screenshot-shrink.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sef/.claude/hooks/turkish-char-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
